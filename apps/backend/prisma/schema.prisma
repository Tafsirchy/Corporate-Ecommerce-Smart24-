// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SUBSCRIBER
  CORPORATE
  BUSINESS
  ADMIN
}

enum BusinessType {
  REGISTERED_COMPANY
  LOCAL_SHOP
  SMALL_BUSINESS
  STARTUP
  RESTAURANT
  PHARMACY
  EDUCATIONAL
  NGO
  HOSPITAL
  GOVERNMENT
  OTHERS
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum VerificationLevel {
  BASIC
  VERIFIED
  PREMIUM
}

enum MembershipTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model BusinessProfile {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  userId             String             @unique @db.ObjectId
  user               User               @relation(fields: [userId], references: [id])
  businessName       String
  businessType       BusinessType
  ownerName          String
  contactPerson      String?
  address            String
  logoUrl            String?
  website            String?
  tradeLicenseNo     String?
  tin                String?
  bin                String?
  verificationLevel  VerificationLevel  @default(BASIC)
  verificationStatus VerificationStatus @default(PENDING)
  membershipTier     MembershipTier     @default(BRONZE)
  
  // Credit Wallet
  creditLimit        Float              @default(0)
  usedCredit         Float              @default(0)
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  
  documents          BusinessDocument[]
  contracts          BusinessContract[]
  rfqs               BusinessRFQ[]
  invoices           BusinessInvoice[]
  savedLists         BusinessSavedList[]
}

enum OfferType {
  AMOUNT_BASED
  FIXED_PACKAGE
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model User {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  email              String   @unique
  password           String
  name               String
  phone              String?
  gender             String?
  birthday           String?
  role               Role     @default(BUYER)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // For Admin TOTP
  twoFactorSecret      String?
  isTwoFactorEnabled   Boolean  @default(false)
  
  // For Email Verification
  isEmailVerified          Boolean   @default(false)
  verificationToken        String?
  verificationTokenExpires DateTime?

  // For Session Invalidation via Password Reset
  tokenVersion             Int       @default(0)

  // For Forgot Password
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  
  cart               Cart?
  wishlist           Wishlist?
  orders             Order[]
  subscriptions      Subscription[]
  quotations         Quotation[]
  followedBrands     FollowedBrand[]
  reviews            Review[]
  addresses          Address[]
  savedPaymentMethods SavedPaymentMethod[]
  returnRequests      ReturnRequest[]
  supportTickets      SupportTicket[]
  
  // Loyalty & Rewards Ecosystem
  lifetimeSpent        Float    @default(0)
  rewardPoints         Float    @default(0)
  membershipId         String?  @db.ObjectId
  membership           MembershipLevel? @relation(fields: [membershipId], references: [id])
  rewardTransactions   RewardTransaction[]
  userRewards          UserReward[]
  subscriptionClaims   SubscriptionClaim[]
  notifications        Notification[]
  backInStockAlerts    BackInStockAlert[]
  businessProfile      BusinessProfile?
}

model Category {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String     @unique
  parentId  String?    @db.ObjectId
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[] @relation("CategoryToCategory")
  level     Int        @default(1) // 1: Top, 2: Sub, 3: Sub-sub
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum FilterType {
  CHECKBOX
  RANGE
  RADIO
  SWATCH
  RATING
}

enum FilterStatus {
  ACTIVE
  SUGGESTED
  INACTIVE
}

type FilterValue {
  value        String
  label        String
  autoDetected Boolean @default(false)
  colorHex     String?
}

type RangeConfig {
  min  Float
  max  Float
  unit String?
  step Float?
}

model FilterDefinition {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  key          String       @unique
  label        String
  type         FilterType
  categoryIds  String[]     @db.ObjectId
  values       FilterValue[] 
  rangeConfig  RangeConfig?  
  status       FilterStatus @default(ACTIVE)
  displayOrder Int          @default(0)
  createdBy    String       @default("admin")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

type ProductAttribute {
  filterKey    String
  value        String
  source       String  @default("manual") // "manual" or "auto-detected"
  confidence   Float?
}

model Brand {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  description String?
  products    Product[]
  followers   FollowedBrand[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FollowedBrand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  brandId   String   @db.ObjectId
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, brandId])
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  sku         String?  @unique
  description String
  price       Float
  discountPrice Float?
  isFlashSale Boolean  @default(false)
  stock       Int      @default(0)
  images      String[] 
  
  rating               Float    @default(0)
  reviewCount          Int      @default(0)
  color                String?
  warrantyType         String?
  brandCompatibility   String?
  caseMaterial         String?
  compatibilityByModel String?
  location             String   @default("Bangladesh")
  services             String[] 
  sellerName           String   @default("Smart24 Official")
  
  returnPolicy         String?  @default("7 Days Return")
  returnWindowDays     Int?     @default(7)
  
  categoryId  String   @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])
  
  brandId     String?  @db.ObjectId
  brand       Brand?   @relation(fields: [brandId], references: [id])
  
  attributes  ProductAttribute[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  subscriptionItems SubscriptionPlanItem[]
  customSubscriptionItems SubscriptionItem[]
  quotations        Quotation[]
  reviews           Review[]
  backInStockAlerts BackInStockAlert[]
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?    @unique @db.ObjectId
  user      User?      @relation(fields: [userId], references: [id])
  sessionId String?    @unique // For guest carts
  
  items     CartItem[]
  
  reminderCount Int      @default(0)
  lastReminderSentAt DateTime?
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int      @default(1)
  
  cartId    String   @db.ObjectId
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([cartId, productId])
}

model Wishlist {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?        @unique @db.ObjectId
  user      User?          @relation(fields: [userId], references: [id])
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  
  wishlistId String   @db.ObjectId
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([wishlistId, productId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  STRIPE
  MANUAL
  BKASH
  NAGAD
  ROCKET
  COD
  NET_30
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
}

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  
  userId          String?       @db.ObjectId
  user            User?         @relation(fields: [userId], references: [id])
  
  guestEmail      String?
  guestName       String?
  
  items           OrderItem[]
  
  totalAmount     Float
  deliveryCharge  Float         @default(0)
  
  status          OrderStatus   @default(PENDING)
  
  subscriptionId  String?       @db.ObjectId
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  paymentTrxId    String?       // For manual payments
  paymentProofUrl String?       // For manual payments (ImgBB URL)
  
  shippingAddress String
  contactNumber   String
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  cancellationReason String?
  earnedPoints       Float?       @default(0)

  discountAmount     Float?       @default(0)
  couponId           String?      @db.ObjectId
  coupon             Coupon?      @relation(fields: [couponId], references: [id])
  userRewardId       String?      @db.ObjectId
  userReward         UserReward?  @relation(fields: [userRewardId], references: [id])

  returnRequests  ReturnRequest[]
  supportTickets  SupportTicket[]
  businessInvoice BusinessInvoice?
}

model OrderItem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  
  orderId         String   @db.ObjectId
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String   @db.ObjectId
  product         Product  @relation(fields: [productId], references: [id])
  
  quantity        Int
  priceAtPurchase Float
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  returnRequests  ReturnRequest[]
}

model SubscriptionPlan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  price       Float
  isActive    Boolean  @default(true)
  
  subscriptions Subscription[]
  items       SubscriptionPlanItem[]
  
  offer       Offer?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubscriptionPlanItem {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  
  planId          String           @db.ObjectId
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  productId       String           @db.ObjectId
  product         Product          @relation(fields: [productId], references: [id])
  
  quantity        Int
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAYMENT_FAILED
}

model Subscription {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  
  userId          String             @db.ObjectId
  user            User               @relation(fields: [userId], references: [id])
  
  planId          String?            @db.ObjectId
  plan            SubscriptionPlan?  @relation(fields: [planId], references: [id])
  
  items           SubscriptionItem[]
  orders          Order[]            // Generated orders
  
  totalAmount     Float
  status          SubscriptionStatus @default(ACTIVE)
  paymentMethod   PaymentMethod
  
  deliveryAddress String
  contactNumber   String
  
  billingDay      Int                // e.g., 5 for 5th of every month
  nextDeliveryDate DateTime
  lastBilledCycle String?            // Idempotency key (e.g., "2026-07")
  
  appliedOfferId  String?            @db.ObjectId
  discountAmount  Float              @default(0)
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model SubscriptionItem {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  
  subscriptionId  String       @db.ObjectId
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  productId       String       @db.ObjectId
  product         Product      @relation(fields: [productId], references: [id])
  
  quantity        Int
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

enum QuotationStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
}

model Quotation {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id])
  
  companyName     String
  contactNumber   String
  contactEmail    String?
  
  // Can be linked to a specific product or general
  productId       String?         @db.ObjectId
  product         Product?        @relation(fields: [productId], references: [id])
  
  quantity        Int
  deliveryLocation String
  deadline        DateTime?
  instructions    String?
  
  status          QuotationStatus @default(PENDING)
  offeredPrice    Float?
  adminNotes      String?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum BannerType {
  MAIN_CAROUSEL
  SPECIAL_OFFER
}

model Banner {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  imageUrl  String
  targetUrl String?
  isActive  Boolean    @default(true)
  order     Int        @default(0)
  type      BannerType @default(MAIN_CAROUSEL)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  comment   String
  images    String[]
  
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  verifiedPurchase Boolean @default(false)
  
  @@unique([userId, productId])
}

model Address {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName          String
  address           String
  postcode          String
  phone             String
  label             String   @default("HOME")
  
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SavedPaymentMethod {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  userId         String        @db.ObjectId
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  provider       PaymentMethod
  accountNumber  String
  isDefault      Boolean       @default(false)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  @@unique([userId, provider, accountNumber])
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model ReturnRequest {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orderId         String        @db.ObjectId
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  orderItemId     String?       @db.ObjectId
  orderItem       OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  
  reason          String
  comments        String?
  status          ReturnStatus  @default(PENDING)
  refundAmount    Float?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?             @db.ObjectId
  user      User?               @relation(fields: [userId], references: [id])
  name      String
  email     String
  subject   String
  message   String
  status    SupportTicketStatus @default(OPEN)
  
  orderId   String?             @db.ObjectId
  order     Order?              @relation(fields: [orderId], references: [id])
  attachments String[]          @default([])

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model Faq {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  category  String
  question  String
  answer    String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  
  helpfulCount    Int @default(0)
  notHelpfulCount Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offer {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  type            OfferType
  discountType    DiscountType
  discountValue   Float
  
  // For AMOUNT_BASED
  minAmount       Float?
  priority        Int          @default(0)
  
  // For FIXED_PACKAGE
  planId          String?      @unique @db.ObjectId
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  
  isFreeDelivery  Boolean      @default(false)
  isActive        Boolean      @default(true)
  startDate       DateTime?
  endDate         DateTime?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
}
model BusinessCollection {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String
  buttonText  String
  imageUrl    String
  targetUrl   String
  position    Int      @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------
// LOYALTY, MEMBERSHIP & REWARDS ECOSYSTEM
// ----------------------------------------------------

model MembershipLevel {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String   @unique
  requiredAmount  Float
  pointMultiplier Float    @default(1.0)
  priority        Int      @default(0) // e.g. 1=Bronze, 5=Diamond
  benefits        String[]
  badgeUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  users           User[]
}

enum RewardType {
  OFFER
  COUPON
  TICKET
  SUBSCRIPTION
}

enum RewardClaimType {
  DIRECT
  POINT_REDEEM
}

enum RewardStatus {
  ACTIVE
  INACTIVE
}

model LoyaltyReward {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  type            RewardType
  claimType       RewardClaimType @default(POINT_REDEEM)
  pointCost       Float           @default(0)
  minMembershipPriority Int       @default(0) // E.g., 1 for Bronze+
  expiryDays      Int?            // Expiry after claim (e.g. 30)
  status          RewardStatus    @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Specific relations
  offerId         String?         @db.ObjectId // If type = OFFER
  couponId        String?         @db.ObjectId // If type = COUPON
  
  userRewards     UserReward[]
}

model Coupon {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  code            String       @unique
  discountType    DiscountType
  discountValue   Float
  minOrderAmount  Float?
  maxDiscount     Float?
  usageLimit      Int?         // Total uses
  currentUses     Int          @default(0)
  expiryDate      DateTime?
  status          RewardStatus @default(ACTIVE)
  
  // For loyalty mapping
  pointCost       Float?       @default(0)
  minMembershipPriority Int?   @default(0)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders          Order[]
}

enum UserRewardStatus {
  AVAILABLE
  USED
  EXPIRED
}

model UserReward {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  userId          String       @db.ObjectId
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rewardId        String       @db.ObjectId
  reward          LoyaltyReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  
  status          UserRewardStatus @default(AVAILABLE)
  claimedAt       DateTime     @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?
  
  // Example code for ticket/coupon
  code            String?      

  orders          Order[]
}

model SubscriptionClaim {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  userId          String       @db.ObjectId
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  membershipId    String       @db.ObjectId
  claimYear       Int          
  
  claimedAt       DateTime     @default(now())
}

enum TransactionReason {
  ORDER_EARN
  REWARD_REDEEM
  ADMIN_ADJUSTMENT
  WELCOME_BONUS
  REFUND_DEDUCT
}

model RewardTransaction {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  userId          String       @db.ObjectId
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  earn            Float        @default(0)
  redeem          Float        @default(0)
  balance         Float
  reason          TransactionReason
  description     String?
  
  orderId         String?      @db.ObjectId // If linked to order
  
  createdAt       DateTime     @default(now())
}

model Notification {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  userId          String       @db.ObjectId
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  message         String
  isRead          Boolean      @default(false)
  type            String?      // e.g., 'MEMBERSHIP_UPGRADE', 'REWARD_CLAIM'
  createdAt       DateTime     @default(now())
}

model BackInStockAlert {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  email     String
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isNotified Boolean @default(false)
  createdAt  DateTime @default(now())
}

enum RFQStatus {
  SUBMITTED
  REVIEWING
  OFFERED
  ACCEPTED
  REJECTED
}

model BusinessDocument {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  businessProfileId  String             @db.ObjectId
  businessProfile    BusinessProfile    @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  documentType       String             // e.g., "TRADE_LICENSE", "NID"
  fileUrl            String             // Encrypted or secure URL
  status             VerificationStatus @default(PENDING)
  adminNotes         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum ContractStatus {
  PENDING_SIGNATURE
  SIGNED
  EXPIRED
  TERMINATED
}

model BusinessContract {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  businessProfileId  String             @db.ObjectId
  businessProfile    BusinessProfile    @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  type               String             // e.g., "NDA", "TERMS_OF_SERVICE", "SALES_AGREEMENT"
  contentUrl         String?            // PDF URL if any
  content            String?            // Or plain text content
  status             ContractStatus     @default(PENDING_SIGNATURE)
  signedAt           DateTime?
  signedByIp         String?
  validUntil         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model BusinessRFQ {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  businessId      String          @db.ObjectId
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id])
  productItems    Json            // Array of { productId, qty, specs }
  expectedBudget  Float?
  expectedDate    DateTime?
  specFileUrl     String?
  status          RFQStatus       @default(SUBMITTED)
  slaDeadline     DateTime?
  adminNotes      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model PricingRule {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  businessType      BusinessType?
  verificationLevel VerificationLevel?
  categoryId        String?           @db.ObjectId
  discountPercent   Float
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  updatedBy         String?           // adminId
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model BusinessInvoice {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String          @unique @db.ObjectId
  order           Order           @relation(fields: [orderId], references: [id])
  businessId      String          @db.ObjectId
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id])
  bin             String?
  tin             String?
  hsCode          String?
  vatAmount       Float           @default(0)
  totalAmount     Float
  status          String          @default("GENERATED") // GENERATED, PAID, VOID
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model BusinessSavedList {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  businessId      String          @db.ObjectId
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id])
  name            String
  productItems    Json            // Array of { productId, qty }
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model AuditLog {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  adminId         String          @db.ObjectId
  action          String
  targetType      String
  targetId        String
  reason          String?
  createdAt       DateTime        @default(now())
}

model HeroContent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String
  imageUrl    String
  categoryUrl String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
