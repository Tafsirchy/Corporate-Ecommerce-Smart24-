# ==========================================
# Database & Authentication
# ==========================================
DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.mongodb.net/smart24?retryWrites=true&w=majority"
JWT_SECRET="your-super-secret-jwt-key"
ENCRYPTION_KEY="your-32-character-encryption-key-for-2fa"

# ==========================================
# Client & Server Origins
# ==========================================
PORT=4000
FRONTEND_URL="http://localhost:3000" # Production: https://www.smart24.live

# ==========================================
# Transactional Email Infrastructure (Resend)
# ==========================================
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="Smart24 Support <support@smart24.live>"
SUPPORT_EMAIL="support@smart24.live"

# ==========================================
# Cloudinary / CDN
# ==========================================
CLOUDINARY_CLOUD_NAME="your-cloudinary-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ==========================================
# Stripe Payments
# ==========================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ==========================================
# Upstash Redis (Rate Limiting & Caching)
# ==========================================
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

